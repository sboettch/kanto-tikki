{
  // Kanto Tikki — its OWN worker on its OWN hostname; the main worker owns
  // the hometikki hostname and cannot be touched by this deploy. Unlisted
  // public preview: no auth, noindex. Rollback: delete this worker.
  "name": "kanto-tikki",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "routes": [
    { "pattern": "kanto.preattention.ai", "custom_domain": true }
  ]
}
